# ============================================
# Binance Vol Scanner - Environment Variables
# Copy to Vercel → Settings → Environment Variables
# ============================================

# Telegram Bot (required)
TELEGRAM_BOT_TOKEN=7xxxxxxxxx:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Google Sheets (required for data storage)
GOOGLE_SHEET_ID=1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_SERVICE_ACCOUNT_EMAIL=vol-scanner@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIExxxxxxx\n-----END RSA PRIVATE KEY-----"

# Optional: Cron secret for security
CRON_SECRET=your-random-secret-here
